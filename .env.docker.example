# ════════════════════════════════════════════════════════════════════════════
# .env para entorno Docker (local / cualquier computadora nueva)
# Copia este archivo como .env al clonar el proyecto:
#
#   cp .env.docker.example .env
#
# ════════════════════════════════════════════════════════════════════════════

APP_NAME="El bajon"
APP_ENV=local
APP_KEY=                              # Generar con: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Mexico_City
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# ── Base de datos (Contenedor MySQL de Docker) ──────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql                         # Nombre del contenedor MySQL en docker-compose
DB_PORT=3306
DB_DATABASE=gestor_capital_db
DB_USERNAME=root
DB_PASSWORD=secret                    # Cambiar si lo deseas en docker-compose.yml

# ── Caché y Sesiones ────────────────────────────────────────────────────────
CACHE_STORE=array
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=capital_gestor_session

# ── Colas ───────────────────────────────────────────────────────────────────
QUEUE_CONNECTION=database

# ── Correo (desactivado en local) ───────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@elbajon.store"
MAIL_FROM_NAME="El Bajón"

# ── Logs ────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Reverb/WebSockets (opcional en local) ───────────────────────────────────
REVERB_APP_ID=local
REVERB_APP_KEY=local-key
REVERB_APP_SECRET=local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# ── Vite (solo para dev local con npm run dev) ───────────────────────────────
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

